  {
   "start": 3.3400000000000047,
   "end": 7.64,
   "text": " Hey Emma, yeah I saw the comment section, amazing right?"
  },
  {
   "start": 9.30000000000001,
   "end": 13.0,
   "text": " Yeah, isn't there a way that we can help others as well?"
  },
  {
   "start": 14.880000000000004,
   "end": 17.84,
   "text": " Yeah, yeah, yeah, like a collaboration."
  },
  {
   "start": 20.240000000000006,
   "end": 26.74,
   "text": " Yeah, indeed, normal pricing is like a thousand, but I mean we're starting out and our pricing"
  },
  {
   "start": 26.74,
   "end": 27.32,
   "text": " is four hundred."
  },
  {
   "start": 28.080000000000002,
   "end": 35.38,
   "text": " But since we're collaborating let's do like minus 50% with the code BFound50 and let's"
  },
  {
   "start": 35.38,
   "end": 36.46,
   "text": " help other people."
  },
  {
   "start": 37.08,
   "end": 40.6,
   "text": " All right, I'm very excited, let's make this happen."
  }
