[
 {
  "i": 1,
  "text": "De fleste virksomheder har en hjemmeside, de ikke er stolte af.",
  "start": 0.4,
  "end": 3.78,
  "a": 0,
  "b": 11,
  "first_key": "w:de"
 },
 {
  "i": 2,
  "text": "Eller slet ingen.",
  "start": 4.22,
  "end": 5.18,
  "a": 11,
  "b": 14,
  "first_key": "w:eller"
 },
 {
  "i": 3,
  "text": "Med Creoble fortæller du kort om din virksomhed.",
  "start": 6.76,
  "end": 9.2,
  "a": 14,
  "b": 22,
  "first_key": "w:med"
 },
 {
  "i": 4,
  "text": "Navn, branche, hvad du laver og hvordan man kontakter dig.",
  "start": 9.68,
  "end": 12.92,
  "a": 22,
  "b": 32,
  "first_key": "w:navn"
 },
 {
  "i": 5,
  "text": "Så bygger Creoble siden til dig.",
  "start": 13.76,
  "end": 15.64,
  "a": 32,
  "b": 38,
  "first_key": "w:s"
 },
 {
  "i": 6,
  "text": "Tekst, billeder og opbygning, alt sammen ud fra det du skrev.",
  "start": 16.08,
  "end": 19.98,
  "a": 38,
  "b": 49,
  "first_key": "w:tekst"
 },
 {
  "i": 7,
  "text": "Du ser hele siden før du betaler en krone.",
  "start": 21.04,
  "end": 23.74,
  "a": 49,
  "b": 58,
  "first_key": "w:du4"
 },
 {
  "i": 8,
  "text": "Og vil du ændre noget, skriver du det bare.",
  "start": 24.2,
  "end": 25.94,
  "a": 58,
  "b": 67,
  "first_key": "w:og3"
 },
 {
  "i": 9,
  "text": "Når du er tilfreds, vælger du selv.",
  "start": 26.92,
  "end": 28.56,
  "a": 67,
  "b": 74,
  "first_key": "w:nr"
 },
 {
  "i": 10,
  "text": "Download siden én gang for alle, eller lad os sætte den online for 99 kroner om måneden.",
  "start": 28.56,
  "end": 34.16,
  "a": 74,
  "b": 91,
  "first_key": "w:download"
 },
 {
  "i": 11,
  "text": "Uden binding.",
  "start": 34.44,
  "end": 34.94,
  "a": 91,
  "b": 93,
  "first_key": "w:uden"
 },
 {
  "i": 12,
  "text": "Vælger du hosting, får du dit eget dk-domæne.",
  "start": 36.08,
  "end": 38.7,
  "a": 93,
  "b": 101,
  "first_key": "w:vlger2"
 },
 {
  "i": 13,
  "text": "E-mail på domænet og siden online på europæiske servere.",
  "start": 38.98,
  "end": 42.4,
  "a": 101,
  "b": 110,
  "first_key": "w:email"
 },
 {
  "i": 14,
  "text": "Det hele sættes op for dig.",
  "start": 42.72,
  "end": 44.16,
  "a": 110,
  "b": 116,
  "first_key": "w:det3"
 },
 {
  "i": 15,
  "text": "Får du nye priser eller et nyt billede, skriver du det i dit panel og siden opdateres.",
  "start": 45.22,
  "end": 49.72,
  "a": 116,
  "b": 133,
  "first_key": "w:fr3"
 },
 {
  "i": 16,
  "text": "Du rører aldrig en linje kode.",
  "start": 50.06,
  "end": 51.72,
  "a": 133,
  "b": 139,
  "first_key": "w:du14"
 },
 {
  "i": 17,
  "text": "Du kan stoppe når som helst.",
  "start": 52.54,
  "end": 53.88,
  "a": 139,
  "b": 145,
  "first_key": "w:du15"
 },
 {
  "i": 18,
  "text": "Prisen er den samme hvert år.",
  "start": 54.26,
  "end": 55.82,
  "a": 145,
  "b": 151,
  "first_key": "w:prisen"
 },
 {
  "i": 19,
  "text": "Og skriver du til os, svarer en dansker.",
  "start": 56.2,
  "end": 58.24,
  "a": 151,
  "b": 159,
  "first_key": "w:og6"
 },
 {
  "i": 20,
  "text": "Byg din side gratis på creoble.dk",
  "start": 59.04,
  "end": 62.38,
  "a": 159,
  "b": 165,
  "first_key": "w:byg"
 }
]