 },
 "accent": "#38C8FF",
 "contrast": {
  "#252525 on #F7F7F7": "14.3:1 body ok",
  "#293A51 on #F7F7F7": "10.8:1 body ok",
  "#49525B on #F7F7F7": "7.4:1 body ok",
  "#252525 on #EBECF4": "13.0:1 body ok",
  "#49525B on #EBECF4": "6.8:1 body ok",
