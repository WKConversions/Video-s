  "#BCC2C9 on #293A51": "6.4:1 body ok",
  "#38C8FF on #293A51": "6.0:1 body ok",
  "#FFFFFF on #394F6D (logo tile)": "8.4:1 body ok",
  "#000000 on #38C8FF": "10.9:1 body ok",
  "#293A51 on #38C8FF": "6.0:1 body ok",
  "#38C8FF on #F7F7F7": "1.8:1 FAILS",
  "#FFFFFF on #38C8FF": "1.9:1 FAILS"
 },
 "rule": "Text: ink/navy/muted on canvas or pale; white/paleCool/onNavyMuted/accent on navy or kb tile; on an accent (#38C8FF) fill only black or navy text. Never cyan text on light grounds or white text on cyan; cyan on light = shapes, rules, dots, fills only.",
 "type": {
  "display": {
   "family": "Montserrat",
   "weight": 700,
   "note": "site h1/h2 are Montserrat 700, tracking normal, sentence case; 800 available for big kinetic words"
  },
  "body": {
   "family": "Montserrat",
   "weights": [
    400,
    500,
    600
   ],
   "note": "body 400 muted-foreground; buttons 600; nav labels 500-600 UPPERCASE tracking-wide"
  },
  "logotype": {
   "family": "Copperplate CC (Heavy)",
   "file": "film/public/fonts/copperplate-cc-heavy.otf",
   "note": "'K.B' set in Copperplate CC Heavy; lowercase are small caps. Licence SIL OFL 1.1 (Cowboy Collective, 2020)."
  },
  "files": {
   "montserrat": "film/public/fonts/montserrat-var-latin.woff2 (+ -latin-ext), variable wght 100-900, OFL",
   "copperplate": "film/public/fonts/copperplate-cc-heavy.otf"
  }
 },
 "logo": {
  "description": "White 'K.B' (Copperplate CC Heavy, round period) centred on a rounded-square tile with a subtle left->right navy gradient #354C67 -> #3D5574 (mid #394F6D); corner radius ~38/512 (7.4%). Letters span 72% of tile width, cap height ~29% of tile.",
  "nav": "On the site header the mark is a 44px navy (#293A51 @85%, backdrop blur, shadow-lg) circle with 'K.B' in Copperplate, colour #F1F5F9; on hover the pill widens to 'K.B  TECH PARTNER'.",
  "files": [
   "assets/logo/favicon-512x512.png (original)",
   "assets/logo/kb-logo-tile.svg (vector rebuild from font outlines, IoU 0.94 vs original)",
   "assets/logo/kb-logo-tile-2048.png",
   "assets/logo/kb-wordmark.svg (letters only, currentColor)"
  ]
 }
