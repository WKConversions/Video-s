 "css": {
  "source": "https://kruslockbosconsultancy.com/_next/static/chunks/1r6vlw8moi03d.css (Tailwind v4 :root,:host theme, shadcn-style tokens), read 2026-10-08",
  "--color-background": "#f7f7f7",
  "--color-foreground": "#252525",
  "--color-primary": "#38c8ff",
  "--color-primary-foreground": "#000",
  "--color-accent": "#38c8ff",
  "--color-accent-foreground": "#000",
  "--color-secondary": "#293a51",
  "--color-secondary-foreground": "#fff",
  "--color-muted": "#f1f5f9",
  "--color-muted-foreground": "#49525b",
  "--color-card": "#ebecf4",
  "--color-card-foreground": "#252525",
  "--color-border": "#e2e8f0",
  "--color-input": "#293a51",
  "--color-ring": "#2563eb",
  "--color-destructive": "#ef4444",
  "--color-slate-500": "#62748e",
  "--radius": ".5rem",
  "--radius-xl": ".75rem",
  "--radius-2xl": "1rem",
  "--radius-3xl": "1.5rem",
  "--ease-in-out": "cubic-bezier(.4, 0, .2, 1)",
  "--default-transition-duration": ".15s",
  "manifest theme_color/background_color": "#2A3A51",
  "font-family": "Montserrat (body, headings, nav, buttons); .logo { font-family: Copperplate } -> @font-face 'copperplate' = CopperplateCC_Heavy.otf"
 },
 "tokens": {
  "canvas": "#F7F7F7",
