 "client": "ClearScaler (www.clearscaler.com), B2B distribution / GTM Engine; dark theme is the site default",
 "css": {
  "_note": "CSS custom properties from the site's inline stylesheet (assets/site/html/site.css); oklch values converted to sRGB hex; alpha colours composited over --cs-night",
  "--cs-night": "#07080c",
  "--cs-ink": "#100c08",
  "--cs-day": "#eceae4",
  "--cs-orange": "#fc7f48",
  "--cs-red": "#c00000",
  "--cs-white": "#edeff3",
  "dark (.dark)": {
   "--surface-0 / --night-0": "#07080C (page canvas)",
   "--surface-1 / --night-1": "oklch(17.5% .004 273) = #101012 (cards, mockup bars, the results band)",
   "--surface-2 / --night-2": "oklch(21.5% .004 273) = #19191B (chips, URL pill, stat tiles)",
   "--surface-3 / --night-3": "oklch(26% .004 273) = #232426",
   "--night-line": "oklch(29% .004 273) = #2B2B2D",
   "--ink / --night-ink": "#EDEFF3",
   "--ink-2 / --night-ink-2": "oklch(76% .003 273) = #B0B1B3 (ledes, body, labels)",
   "--ink-3 / --night-ink-3": "oklch(65% .003 273) = #8E8F91 (mono eyebrows, muted second sentence of H2s, logo wall)",
   "--rule / --night-rule": "white 12% = #252629 on night (#2D2D2F on surface-1)",
   "--rule-strong / --night-rule-strong": "white 22% = #3E3E41 on night (hairline loop, outlined buttons and pills)",
   "--field-border / --night-field-border": "white 36% = #606163",
   "--brand": "var(--cs-orange) #FC7F48",
   "--on-brand": "var(--cs-night) #07080C (text on orange)",
   "--brand-glow": "orange at 22% (= #3D2219 over night); glow gradients use 12% to 18%",
   "--brand-soft": "oklch(30% .1 42) (≈ #541500, clipped)",
   "--success": "oklch(74% .15 155) = #4BC680 (Strong fit, Replied, Meeting booked, Sent, REPLIED count)",
   "--success-soft": "oklch(26% .05 140) = #162A12 (chip backgrounds)",
   "--danger": "oklch(70% .18 22) = #FA686A",
   "--danger-soft": "oklch(27% .09 22) = #490D11"
  },
  "light (:root)": {
   "--surface-0": "#ECEAE4",
   "--surface-1": "#F6F4EF",
   "--surface-2": "#E3E0D8",
   "--ink": "#100C08",
   "--ink-2": "#524C47",
   "--ink-3": "#655F5B",
   "--rule": "#D6D0CB",
   "--rule-strong": "#AAA39D",
   "--brand": "#C00000 (red in light mode)",
   "--success": "#0A6D37"
  },
  "radii": {
   "--radius": ".375rem (6px)",
   "--radius-tag": "6px",
   "--radius-control": "12px (buttons)",
   "--radius-pill": "999px",
   "--radius-window": "20px (mockup browser frame)",
   "--radius-surface": "28px (quote panel, big cards)",
   "--mk-r": "14px (mockup cards)"
  },
  "durations": {
   "--dur-1": ".12s",
   "--dur-2": ".24s",
   "--dur-3": ".48s",
   "--dur-4": ".9s",
   "--dur-5": "1.2s",
   "--dur-loop": "9s",
   "--dur-press": "80ms",
   "--rise": "12px",
   "--default-transition-duration": ".15s"
  },
  "easing": {
   "--ease-out": "cubic-bezier(.2,.7,.2,1)",
   "--ease-emphasis": "cubic-bezier(.16,1,.3,1)",
   "--ease-in-out": "cubic-bezier(.6,0,.2,1)",
   "--ease-spring": "linear(0, .6 18%, 1.02 38%, .99 60%, 1)",
   "--mk-ease": "cubic-bezier(.2,.7,.2,1)",
   "--mk-ease-em": "cubic-bezier(.16,1,.3,1)"
  },
  "layout": {
   "container": "1104px content width (x 168 to 1272 at a 1440 viewport)",
   "--gutter": "20px / 40px / 48px",
   "--section-sm": "40px / 48px",
   "--section-md": "44 to 80px",
   "--section-lg": "80px / 128px",
   "nav_height": "72px desktop, fixed, surface-0"
  },
  "theme_color_meta": "#07080C dark, #ECEAE4 light; the app resolves to dark for anyone with no stored choice"
 },
 "tokens": {
  "night": "#07080C",
  "surface1": "#101012",
  "surface2": "#19191B",
  "surface3": "#232426",
  "line": "#2B2B2D",
  "rule": "#252629",
  "ruleStrong": "#3E3E41",
  "fieldBorder": "#606163",
  "ink": "#EDEFF3",
  "ink2": "#B0B1B3",
  "ink3": "#8E8F91",
  "orange": "#FC7F48",
  "orangeGlow": "#3D2219",
  "success": "#4BC680",
  "successSoft": "#162A12",
  "danger": "#FA686A"
 },
 "accent": "#FC7F48",
 "contrast": {
  "#EDEFF3/#07080C": 17.4,
  "#B0B1B3/#07080C": 9.3,
  "#8E8F91/#07080C": 6.2,
  "#FC7F48/#07080C": 7.9,
  "#07080C/#FC7F48": 7.9,
  "#EDEFF3/#FC7F48": 2.2,
  "#EDEFF3/#101012": 16.5,
  "#B0B1B3/#101012": 8.9,
  "#8E8F91/#101012": 5.9,
  "#B0B1B3/#19191B": 8.2,
  "#EDEFF3/#19191B": 15.2,
  "#4BC680/#162A12": 7.1,
  "#4BC680/#07080C": 9.2,
  "#4BC680/#101012": 8.8,
  "#FA686A/#07080C": 6.9,
  "#100C08/#ECEAE4": 16.2,
  "#C00000/#ECEAE4": 5.4,
  "rule": "orange carries text on night (7.9:1: the brand word in a headline, stat units, links' underline); text ON orange is always night #07080C (buttons, quote panel), never white (2.2:1 fails). ink-3 #8E8F91 is fine for 12px mono labels (6.2:1). Green #4BC680 is status only (chips, counts, checks) on #162A12 or night."
 },
 "type": {
  "files": "film/public/fonts/outfit-var.woff2 (Outfit Variable, wght axis 500 to 600 only), manrope-var.woff2 + manrope-latin-ext-var.woff2 (Manrope Variable, 200 to 800), geist-mono-var.woff2 (Geist Mono Variable, 400 to 600). Latin subsets; no U+2192 arrow glyph in any of them.",
  "display": {
   "family": "Outfit Variable",
   "weight": 600,
   "tracking": "-0.045em",
   "leading": 0.98,
   "case": "Sentence",
   "example": "Your distribution, fixed. at 103.68px (h1 extract: 600, -4.6656px) on a 1440 page; the brand word in #FC7F48; clamp(44px, 7.2vw, 104px); split-layout page heroes 72px / 1.02 (-3.24px)"
  },
  "h2": {
   "family": "Outfit Variable",
   "weight": 560,
   "tracking": "-0.035em",
   "leading": 1.04,
   "size": "clamp(30px, 3.6vw, 52px) = 51.84px at 1440",
   "example": "Three channels. One loop, run by us. (second sentence in ink-3 #8E8F91)"
  },
  "statement": {
   "family": "Outfit Variable",
